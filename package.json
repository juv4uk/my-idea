{
  "name": "my-idea",
  "version": "0.10.0",
  "private": true,
  "description": "Lightweight programming IDE built with Tauri, ClojureScript and CodeMirror 6",
  "license": "MIT",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "shadow-cljs watch app",
    "build": "node scripts/build.mjs",
    "wasm": "wasm-pack build crates/my-lisp-wasm --target web --out-dir public/wasm --no-pack",
    "check": "shadow-cljs compile app",
    "test": "node --test tests/*.test.mjs && shadow-cljs compile test",
    "benchmark": "node scripts/benchmark.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@nextjournal/lang-clojure": "^1.0.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "codemirror-lang-mermaid": "^0.5.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "shadow-cljs": "^3.4.12"
  }
}
