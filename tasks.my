    (done . ())
  ))
  ("IDEA-STOP-BUILD" . (
    (priority . 9.1)
    (depends-on . (IDEA-BUILD-PROCESS-CONTRACT IDEA-BUILD-OUTPUT-UI))
    (description . "Wire the Stop action to bounded process-tree cancellation and prove that no child compiler/dev-server remains alive. Stop is hidden or disabled when no run is active; cancellation is distinct from failure.")
    (done . ())
  ))
  ("IDEA-WSM-CLI-ADAPTER" . (
