    (done . ())
  ))
  ("IDEA-TAURI-BUILD-ADAPTER" . (
    (priority . 9.3)
    (depends-on . (IDEA-BUILD-PROCESS-CONTRACT))
    (description . "Detect a Tauri project through package.json, src-tauri/Cargo.toml and Tauri config. Implement fixed Check/Dev/Build profiles using the repository's Bun/Cargo/Tauri contract, frozen dependency installation, fixed cwd, argv arrays, live output and typed missing-tool errors.")
    (done . ())
  ))
  ("IDEA-SELF-BUILD-WITNESS" . (
    (priority . 9.0)
