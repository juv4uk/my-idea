    (done . ())
  ))
  ("IDEA-LSP-CLIENT-TRANSPORT" . (
    (priority . 9.65)
    (depends-on . (IDEA-PRODUCT-RESET-ADR))
    (description . "Implement one persistent Tauri-side LSP/JSON-RPC stdio client with Content-Length framing, request correlation, server notifications, workspace-root lifecycle and bounded shutdown. It must accept executable+argv profiles, not shell strings, and expose no language semantics of its own.")
