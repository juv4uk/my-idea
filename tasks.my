 (tasks .
  (("IDEA-CARGO-CHECK" . ((priority . 0.8) (capabilities . (rust)) (done . t)
                          (description . "DONE 2026-08-12. Root cause found via strace (guix shell strace): fchmod(fd, 0100777) on a just-created OUT_DIR file in tauri-build's ACL generation fails EPERM on the /mnt/c/GitHub/my-idea DrvFs mount specifically (confirmed independently: chmod 777 fails on DrvFs, succeeds on native WSL ext4 — same class of issue as npm --no-bin-links and Bun's lockfile fchmod, documented in AGENTS.md). Fix: export CARGO_TARGET_DIR=$HOME/.cache/my-idea-target before cargo build/check/test. Verified: cargo check --workspace finished clean, 0 errors. Documented in AGENTS.md commit b372404."))))))
